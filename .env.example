# ============================================================
# CONFIGURACAO LOCAL - VALORES FICTICIOS
# Copie para .env e substitua apenas no ambiente de execucao.
# Nunca versione o arquivo .env real.
# ============================================================

# --- Rastreamento demonstrativo ---
TRACKING_MOCK_STATUS=Status simulado

# --- Servidor Flask / dashboard --------------------------------
HOST=127.0.0.1
PORT=5000

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_VALOR_ALEATORIO_LONGO

DASH_USER=admin
# Gere com (troque SUA_SENHA):
# python -c "import hashlib,secrets; s=secrets.token_bytes(16); d=hashlib.scrypt(b'SUA_SENHA', salt=s, n=2**14, r=8, p=1, dklen=32); print('scrypt$'+s.hex()+'$'+d.hex())"
DASH_PASSWORD_HASH=SUBSTITUA_PELA_SENHA_HASH

# Token usado pelo bot em GET /dados.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
DADOS_TOKEN=SUBSTITUA_POR_TOKEN_ALEATORIO_DO_BOT

# Acesso remoto: use proxy TLS na frente do Flask.
# Basic Auth so e aceito em loopback ou HTTPS/proxy confiavel.
TRUST_PROXY=0
TRUSTED_PROXY_IPS=127.0.0.1
COOKIE_SECURE=0

# --- Bot WhatsApp ----------------------------------------------
# Mantem o comportamento original. Use outro caminho em testes.
WA_SESSION_PATH=./whatsapp_session

# URL da API de dados. Hosts loopback aceitam HTTP; demais exigem HTTPS.
# Se você alterar PORT acima, altere também a porta desta URL.
DADOS_URL=http://127.0.0.1:5000/dados
DADOS_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# JSON fictício opcional, lido apenas em DRY_RUN (nenhuma chamada de rede).
DADOS_MOCK_FILE=

# 1 = sem WhatsApp, sem rede (Tracking e /dados) e sem envio de mensagens.
DRY_RUN=1

# Arquivo de dados (fora do repositorio e protegido por ACL).
DADOS_FILE=dados.json

# Caminho opcional do navegador Microsoft Edge
BROWSER_PATH=
